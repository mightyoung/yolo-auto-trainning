# =============================================================================
# YOLO Auto-Training — .gitignore
# Industry-standard patterns for Python ML/AI projects
# =============================================================================

# Environment files — NEVER commit real credentials
.env
.env.local
.env.*.local
.env.example        # Keep .env.example as a template
business-api/.env
business-api/.env.*
training-api/.env
training-api/.env.*
web-ui-react/.env
web-ui-react/.env.*

# Auth artifacts — never commit tokens or session data
.token.txt
*.token
login_result.txt
login_test*.txt
biz_startup*.txt
biz_server*.log
e2e_test.log
task_submit_log.txt
training_api_check.txt
training_errors.txt
health_test.txt
wget_result.txt
server_ps*.txt
biz_server*.log

# Test reports may contain credentials from test runs
test_reports/

# Colab secrets (local API keys - never commit)
colab/secrets.env

# Virtual environments
.venv/
venv/
ENV/
env/
.venv

# IDE
.idea/
.vscode/
*.swp
*.swo
*.swn
*.code-workspace

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# ML model artifacts — never commit trained weights
*.pt
*.pth
*.weights
*.onnx
*.tflite
*.trt
*.engine
*.pkl
*.joblib
*.h5
*.pb
*.tflite

# Training runs & experiment outputs
runs/
outputs/
logs/
*.log
wandb/
tensorboard/
mlruns/

# Data directories — datasets can be large
data/
datasets/
*.csv
*.json
!data/.gitkeep
!requirements.txt

# Models registry
models/
checkpoints/
artifacts/

# Docker
.dockerignore

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Claude Code
.claude/
.gitnexus/

# Agent swarm memory (local agent state - never commit)
.swarm/

# Documentation site build artifacts
docs/_build/
site/

# Deployment & helper scripts (contain credentials - NEVER commit)
final_deploy.py
startup_gpu.py
deploy_online.sh
deploy_training_api_gpu.sh
task_plan_e2e.md
task_plan_react_migration.md

# npm / Node (for web-ui-react)
web-ui-react/node_modules/
web-ui-react/.next/
web-ui-react/out/
web-ui-react/.turbo/

# Temporary / cache files
*.tmp
*.bak
*.swp
.cache/
.npm/
.yarn/
